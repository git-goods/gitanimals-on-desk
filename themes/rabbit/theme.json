{
  "_comment": "Rabbit theme — adapted from GitAnimals rabbit pixel art",

  "schemaVersion": 1,
  "type": "persona",
  "personaType": "RABBIT",
  "name": "Rabbit",
  "author": "sumi",
  "version": "1.0.0",
  "description": "A hopping pixel-art rabbit with pink cheeks",
  "license": "MIT",

  "viewBox": { "x": -15, "y": -25, "width": 45, "height": 45 },

  "layout": {
    "contentBox": { "x": -5, "y": -9, "width": 20, "height": 24 },
    "centerX": 4,
    "baselineY": 7,
    "visibleHeightRatio": 0.6,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "enabled": false,
    "states": ["idle"]
  },

  "states": {
    "idle":         ["idle-follow.svg"],
    "thinking":     ["thinking.svg"],
    "working":      ["typing.svg"],
    "error":        ["error.svg"],
    "attention":    ["happy.svg"],
    "notification": ["notification.svg"],
    "sleeping":     ["sleeping.svg"],
    "waking":       ["waking.svg"]
  },

  "timings": {
    "minDisplay": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000,
    "wakeDuration": 5000
  },

  "hitBoxes": {
    "default":  { "x": -6, "y": -10, "w": 20, "h": 22 },
    "sleeping": { "x": -6, "y": -8, "w": 20, "h": 20 }
  },
  "sleepingHitboxFiles": ["sleeping.svg"],

  "miniMode": {
    "supported": true,
    "offsetRatio": 0.3,
    "flipAssets": true,
    "states": {
      "mini-idle":        ["mini-idle.svg"],
      "mini-alert":       ["mini-idle.svg"],
      "mini-happy":       ["mini-idle.svg"],
      "mini-enter":       ["mini-idle.svg"],
      "mini-peek":        ["mini-idle.svg"],
      "mini-enter-sleep": ["mini-sleep.svg"],
      "mini-sleep":       ["mini-sleep.svg"]
    },
    "timings": {
      "minDisplay": { "mini-alert": 4000, "mini-happy": 4000 },
      "autoReturn": { "mini-alert": 4000, "mini-happy": 4000 }
    }
  },

  "accessories": {
    "zzz": {
      "name": "Zzz",
      "file": "shared:acc-zzz.svg",
      "anchors": {
        "sleeping":         { "parentId": "root", "transform": "translate(12, -4)" },
        "mini-sleep":       { "parentId": "root", "transform": "translate(14, -4)" },
        "mini-enter-sleep": { "parentId": "root", "transform": "translate(14, -4)" },
        "*": null
      }
    },
    "notebook": {
      "name": "노트북",
      "file": "shared:acc-notebook.svg",
      "anchors": {
        "*": null,
        "working": { "parentId": "root", "transform": "translate(7, -0.5) scale(1.5)" }
      }
    },
    "bubble-thinking": {
      "name": "말풍선",
      "file": "shared:acc-bubble-thinking.svg",
      "anchors": {
        "thinking": { "parentId": "root", "transform": "translate(12, -18)" },
        "*": null
      }
    }
  },

  "variants": [
    {
      "id": "rabbit",
      "name": "Rabbit",
      "accessories": ["zzz", "notebook", "bubble-thinking"]
    }
  ],

  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
