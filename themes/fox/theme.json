{
  "_comment": "Dessert Fox theme — adapted from GitAnimals dessert-fox pixel art",

  "schemaVersion": 1,
  "name": "Dessert Fox",
  "author": "sumi",
  "version": "1.0.0",
  "description": "A coding fox with a pocket notebook — pixel-perfect fennec inspired by GitAnimals",
  "license": "MIT",

  "viewBox": { "x": -15, "y": -25, "width": 45, "height": 45 },

  "layout": {
    "contentBox": { "x": -2, "y": -2, "width": 20, "height": 18 },
    "centerX": 7.5,
    "baselineY": 15,
    "visibleHeightRatio": 0.58,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "enabled": false,
    "states": ["idle"],
    "eyeRatioX": 0.52,
    "eyeRatioY": 0.45,
    "maxOffset": 1.5,
    "bodyScale": 0.25,
    "shadowStretch": 0.15,
    "shadowShift": 0.3,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "7.5px 14px"
  },

  "states": {
    "idle":         ["idle-follow.svg"],
    "thinking":     ["thinking.svg"],
    "working":      ["typing.svg"],
    "error":        ["idle-follow.svg"],
    "attention":    ["idle-follow.svg"],
    "notification": ["notification.svg"],
    "sleeping":     ["idle-follow.svg"],
    "waking":       ["idle-follow.svg"]
  },

  "timings": {
    "minDisplay": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },

  "hitBoxes": {
    "default":  { "x": -1, "y": 4, "w": 16, "h": 12 },
    "sleeping": { "x": -2, "y": 9, "w": 18, "h": 7 }
  },
  "sleepingHitboxFiles": ["idle-follow.svg"],

  "miniMode": { "supported": false },

  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
