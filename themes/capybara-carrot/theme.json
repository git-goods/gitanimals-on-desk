{
  "_comment": "Capybara Carrot theme — ported from GitAnimals capybara pixel art (carrot variant)",

  "schemaVersion": 1,
  "type": "persona",
  "personaType": "CAPYBARA_CARROT",
  "name": "Capybara Carrot",
  "author": "sumi",
  "version": "1.0.0",
  "description": "당근을 든 픽셀 카피바라",
  "license": "MIT",

  "viewBox": { "x": -15, "y": -25, "width": 45, "height": 45 },

  "layout": {
    "contentBox": { "x": -5, "y": -5, "width": 22, "height": 24 },
    "centerX": 6,
    "baselineY": 17.5,
    "visibleHeightRatio": 0.6,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "enabled": false,
    "states": ["idle"]
  },

  "states": {
    "idle": ["idle-follow.svg"],
    "thinking": ["thinking.svg"],
    "working": ["typing.svg"],
    "juggling": ["typing.svg"],
    "carrying": ["idle-follow.svg"],
    "sweeping": ["typing.svg"],
    "error": ["error.svg"],
    "attention": ["happy.svg"],
    "notification": ["notification.svg"],
    "sleeping": ["sleeping.svg"],
    "waking": ["waking.svg"],
    "idle-look": ["idle-follow.svg"],
    "yawning": ["sleeping.svg"],
    "dozing": ["sleeping.svg"],
    "collapsing": ["sleeping.svg"]
  },

  "timings": {
    "minDisplay": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000,
    "wakeDuration": 5000
  },

  "hitBoxes": {
    "default": { "x": -5, "y": -5, "w": 22, "h": 24 }
  },

  "miniMode": {
    "supported": true,
    "offsetRatio": 0.3,
    "flipAssets": true,
    "states": {
      "mini-idle": ["mini-idle.svg"],
      "mini-alert": ["mini-idle.svg"],
      "mini-happy": ["mini-idle.svg"],
      "mini-enter": ["mini-idle.svg"],
      "mini-peek": ["mini-idle.svg"],
      "mini-enter-sleep": ["mini-sleep.svg"],
      "mini-sleep": ["mini-sleep.svg"]
    },
    "timings": {
      "minDisplay": { "mini-alert": 4000, "mini-happy": 4000 },
      "autoReturn": { "mini-alert": 4000, "mini-happy": 4000 }
    }
  },

  "accessories": {
    "zzz": {
      "name": "Zzz",
      "file": "shared:acc-zzz.svg",
      "anchors": {
        "sleeping": { "parentId": "root", "transform": "translate(15, -2)" },
        "dozing": { "parentId": "root", "transform": "translate(15, -2)" },
        "yawning": { "parentId": "root", "transform": "translate(15, -2)" },
        "collapsing": { "parentId": "root", "transform": "translate(15, -2)" },
        "mini-sleep": { "parentId": "root", "transform": "translate(15, -2)" },
        "mini-enter-sleep": {
          "parentId": "root",
          "transform": "translate(15, -2)"
        },
        "*": null
      }
    },
    "notebook": {
      "name": "노트북",
      "file": "shared:acc-notebook.svg",
      "anchors": {
        "*": null,
        "working": {
          "parentId": "root",
          "transform": "translate(8.7, 8) scale(1.8)"
        },
        "juggling": {
          "parentId": "root",
          "transform": "translate(13, 8) scale(1.8)"
        },
        "sweeping": {
          "parentId": "root",
          "transform": "translate(13, 8) scale(1.8)"
        }
      }
    },
    "bubble-thinking": {
      "name": "말풍선",
      "file": "shared:acc-bubble-thinking.svg",
      "anchors": {
        "thinking": { "parentId": "root", "transform": "translate(13, -10)" },
        "*": null
      }
    }
  },

  "variants": [
    {
      "id": "capybara-carrot",
      "name": "Capybara Carrot",
      "accessories": ["zzz", "notebook", "bubble-thinking"]
    }
  ],

  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
