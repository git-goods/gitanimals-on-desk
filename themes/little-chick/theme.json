{
  "_comment": "Little Chick theme — pixel-art chick with optional sunglasses accessory",

  "schemaVersion": 1,
  "type": "free",
  "personaType": "LITTLE_CHICK",
  "name": "Little Chick",
  "author": "sumi",
  "version": "1.0.0",
  "description": "머리를 까딱이는 픽셀 병아리",
  "license": "MIT",

  "variants": [
    {
      "id": "little-chick",
      "name": "Little Chick",
      "accessories": ["notebook", "zzz", "bubble-thinking", "bubble-error"]
    },
    {
      "id": "little-chick-sunglasses",
      "name": "Little Chick Sunglasses",
      "accessories": [
        "sunglasses",
        "notebook",
        "zzz",
        "bubble-thinking",
        "bubble-error"
      ]
    }
  ],

  "accessories": {
    "sunglasses": {
      "name": "선글라스",
      "file": "shared:acc-sunglasses.svg",
      "anchors": {
        "*": {
          "parentId": "little-chick-head",
          "transform": "translate(-1.1, -0.1) scale(0.85)"
        },
        "sleeping": null,
        "mini-sleep": null
      }
    },
    "notebook": {
      "name": "노트북",
      "file": "shared:acc-notebook.svg",
      "anchors": {
        "*": null,
        "working": { "parentId": "root", "transform": "translate(7, 5)" }
      }
    },
    "zzz": {
      "name": "Zzz",
      "file": "shared:acc-zzz.svg",
      "anchors": {
        "sleeping": { "parentId": "root", "transform": "translate(10, -2)" },
        "mini-sleep": { "parentId": "root", "transform": "translate(12, -2)" },
        "mini-enter-sleep": {
          "parentId": "root",
          "transform": "translate(12, -2)"
        },
        "*": null
      }
    },
    "bubble-thinking": {
      "name": "말풍선",
      "file": "shared:acc-bubble-thinking.svg",
      "anchors": {
        "thinking": {
          "parentId": "root",
          "transform": "translate(10, -9.1) scale(0.75) rotate(-1)"
        },
        "*": null
      }
    },
    "bubble-error": {
      "name": "에러 말풍선",
      "file": "shared:acc-bubble-error.svg",
      "anchors": {
        "error": { "parentId": "root", "transform": "translate(11, -9)" },
        "*": null
      }
    }
  },

  "viewBox": { "x": -15, "y": -25, "width": 45, "height": 45 },

  "layout": {
    "contentBox": { "x": -2, "y": -2, "width": 16, "height": 14 },
    "centerX": 6,
    "baselineY": 10,
    "visibleHeightRatio": 0.58,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "enabled": false,
    "states": ["idle"]
  },

  "states": {
    "idle": ["idle-follow.svg"],
    "thinking": ["thinking.svg"],
    "working": ["typing.svg"],
    "error": ["error.svg"],
    "attention": ["happy.svg"],
    "notification": ["notification.svg"],
    "sleeping": ["sleeping.svg"],
    "waking": ["waking.svg"]
  },

  "timings": {
    "minDisplay": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4000,
      "error": 5000,
      "notification": 2500
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000,
    "wakeDuration": 5000
  },

  "hitBoxes": {
    "default": { "x": -2, "y": -4, "w": 18, "h": 16 },
    "sleeping": { "x": -2, "y": -2, "w": 18, "h": 14 }
  },
  "sleepingHitboxFiles": ["sleeping.svg"],

  "miniMode": {
    "supported": true,
    "offsetRatio": 0.3,
    "flipAssets": true,
    "states": {
      "mini-idle": ["mini-idle.svg"],
      "mini-alert": ["mini-idle.svg"],
      "mini-happy": ["mini-idle.svg"],
      "mini-enter": ["mini-idle.svg"],
      "mini-peek": ["mini-idle.svg"],
      "mini-enter-sleep": ["mini-sleep.svg"],
      "mini-sleep": ["mini-sleep.svg"]
    },
    "timings": {
      "minDisplay": { "mini-alert": 4000, "mini-happy": 4000 },
      "autoReturn": { "mini-alert": 4000, "mini-happy": 4000 }
    }
  },

  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
