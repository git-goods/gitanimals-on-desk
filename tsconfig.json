{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/settings/prefs.ts",
    "src/settings/agent-gate.js",
    "src/settings/actions.ts",
    "src/settings/store.ts",
    "src/settings/controller.ts",
    "src/preload/settings-bridge.ts",
    "src/settings/renderer.tsx",
    "src/core/state-selectors.ts",
    "src/core/settings-runtime.ts",
    "src/theme/loader.ts",
    "src/theme/remote-sync.ts",
    "src/core/telemetry.js",
    "agents/**/*.js",
    "hooks/json-utils.ts",
    "hooks/shared-process.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".worktrees",
    "tools/preview"
  ]
}
