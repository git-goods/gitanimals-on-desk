{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/core/state-selectors.ts",
    "src/core/settings-runtime.ts",
    "src/preload/settings-bridge.ts",
    "src/settings/actions.ts",
    "src/settings/controller.ts",
    "src/settings/prefs.ts",
    "src/settings/store.ts",
    "src/theme/loader.ts",
    "src/theme/remote-sync.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".worktrees",
    ".tsbuild",
    "tools/preview"
  ]
}
