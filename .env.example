# Copy this file to `.env` and edit as needed. `.env` is git-ignored.
# Values here do NOT override variables already set in the shell.

# ── Remote theme system ──

# Base URL of the theme registry server. Overrides the built-in default.
# Server must serve:
#   GET {URL}/themes/index.json        -> [{ id, name, version }, ...]
#   GET {URL}/themes/<id>/theme.json   -> theme config
#   GET {URL}/themes/<id>/<file>.svg   -> SVG asset
# For local development, start a mock server and set this to http://localhost:<port>.
# HTTP (non-HTTPS) URLs are only honored when this variable starts with `http://`.
#
# THEME_REGISTRY_URL=http://localhost:8765

# ── GitAnimals backend ──
# 두 서버를 독립 제어. 각 변수 미설정 시 프로덕션 URL 사용.
# HTTP은 값이 http:// 로 시작할 때만 허용 (downgrade 방지).

# Identity ("API") server — 토큰 기반 본인 조회 (GET /users)
# 기본값: https://api.gitanimals.org
# 로컬 Identity 띄울 때만 오버라이드.
#
# API_BASE_URL=http://localhost:xxxx

# Render server — 페르소나/에셋 (GET /users/{username}, /assets, SVG)
# 기본값: https://render.gitanimals.org
# 로컬 render(8080)에 띄운 상태면 아래 활성화.
#
# RENDER_BASE_URL=http://localhost:8080

# Base URL for the web login page (`{WEB_BASE_URL}/auth/desktop`).
# Leave unset in most cases — overriding is only useful when running
# the gitanimals.org web app locally.
#
# WEB_BASE_URL=https://gitanimals.org

# ── Sentry (crash/diagnostics) ──
# Leave blank to disable. Precedence: env > .env > package.json.
#
# SENTRY_DSN=
